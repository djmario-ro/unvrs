{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^@ ]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "homeAssistant": {
      "type": "object",
      "required": [
        "existingSecret",
        "url",
        "doorScripts"
      ],
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^ /]+/?$"
        },
        "doorScripts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^script\\.[a-z0-9_]+$"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "provider",
        "oidc"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "local",
            "keycloak"
          ]
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "clientId",
            "existingSecret"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^https://[^ /]+/realms/[a-zA-Z0-9._-]+$"
            },
            "clientId": {
              "type": "string",
              "minLength": 1
            },
            "existingSecret": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
