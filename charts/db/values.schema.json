{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "clusterName",
    "databaseName",
    "databaseOwner",
    "existingSecret"
  ],
  "properties": {
    "clusterName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z_][a-z0-9_-]*$"
    },
    "databaseName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z_][a-z0-9_-]*$"
    },
    "databaseOwner": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z_][a-z0-9_-]*$"
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z_][a-z0-9_-]*$"
    }
  }
}
