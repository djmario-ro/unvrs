# Copy to .env and adjust. podman-compose.yml reads this file (env_file: .env).

# Security — REQUIRED in production (startup refuses the placeholder when DEBUG=false).
# Generate e.g. with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please
DEBUG=false

# Sender name shown in guest PIN messages
GUESTHOUSE_NAME=Guesthouse

# Master admin account, reconciled from these settings on every startup.
# Change ADMIN_PASSWORD before the first production deploy.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Default country code (no +) used to normalize local numbers like 0743... -> 40743...
DEFAULT_COUNTRY_CODE=40

# IANA timezone for displaying stay dates in guest messages (timestamps stay UTC)
TIMEZONE=Europe/Bucharest

# CORS / links — set to the public URL in production
FRONTEND_ORIGIN=http://localhost:8080

# Cookies (set COOKIE_SECURE=true behind HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# SMS gateway (sms-gate.app). Leave URL blank to log to the console instead of sending.
# Cloud endpoint: https://api.sms-gate.app/3rdparty/v1/message
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# WhatsApp service — configure after deploying it separately. Leave blank to mock.
WHATSAPP_SERVICE_URL=
# Shared secret authenticating the sidecar's /send, /qr, /status. REQUIRED:
# the sidecar refuses to start without it. Generate like SECRET_KEY above.
WHATSAPP_API_TOKEN=

# Networks of the reverse proxies in front of the backend: CIDRs and/or the
# groups "private" (nginx, Traefik) and "cloudflare". Rate limiting skips them
# when reading X-Forwarded-For to find the real client IP.
TRUSTED_PROXIES=private

# Door control (backend only). Configure entity IDs in the admin room editor.
# Missing configuration returns an opening error, never success.
HA_URL=https://home161.cloud.retreat480.com
HA_TOKEN=
# Legacy mapping for the one-time upgrade migration only.
HA_DOOR_SCRIPTS={}
